{
  "name": "synapse-workspace",
  "description": "Synapse Workspace Client",
  "private": true,
  "version": "1.0.5",
  "main": "dist-electron/electron/main.js",
  "author": "Brainmouse",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "predist": "npx cross-env DATABASE_URL=file:./template.db npx prisma db push --force-reset --accept-data-loss",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run predist && npm run transpile:electron && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run transpile:electron && npm run build && electron-builder --linux --x64",
    "test:e2e": "playwright test",
    "test:vitest": "vitest src"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/local-auth": "^3.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^5.19.1",
    "@tailwindcss/typography": "^0.5.19",
    "@xyflow/react": "^12.10.0",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "diff-match-patch": "^1.0.5",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^12.29.2",
    "googleapis": "^171.0.0",
    "latex.js": "^0.12.6",
    "lucide-react": "^0.563.0",
    "node-cron": "^4.2.1",
    "os-utils": "^0.0.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.1",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/d3-force": "^3.0.10",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/os-utils": "^0.0.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "prisma": "^5.19.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}